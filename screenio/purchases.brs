01000 Main: ! If you run me as a program, I run the purchases screen
01010    library "screenio" : fnfm$
01020    let Ret$=fnfm$("purchases","",0,0,"",0,0,0,0,mat PassedData$)
01030    if len(trim$(Ret$)) then
01040       print Ret$
01050    end if
01060    if fkey=93 then execute "system"
01070    stop
01080 !
05000 CustomFunctions: ! Lines 5000 - 70000 are Custom Functions
05001 ! ============================================================
05002 ! Imported From "function\purchasesfilter.brs"
05003 ! function\purchasesfilter.brs
05004 ! Created on 10/10/2026
05005 !
05006 ! fnPurchasesFilter$ - Filter for the PURCHASES list. Shows every purchase, and
05007 !   fills the Description column by looking the item up in inventory.
05008 !
05009 ! fnInit_PurchasesFilter / fnFinal_PurchasesFilter - ScreenIO runs these once before
05010 !   and after the list is filled, so inventory is opened once per refresh, not once
05011 !   per row. It is opened OutIn, like every other open of inventory in this session
05012 !   (BR error 0608 otherwise).
05013 !
05014 dim PfInv$(1)*1024, PfInv(1), PfInvFile
05015 !
05016 def fnPurchasesFilter$
05017    let S$(SIO_ITEMDESC)=""
05018    if PfInvFile then
05019       read #PfInvFile, using form$(PfInvFile), key=fnKey$(PfInvFile,F$(PU_ITEMID)): mat PfInv$, mat PfInv nokey PurchasesFilterNoItem
05020       let S$(SIO_ITEMDESC)=PfInv$(IN_DESCRIPTION)
05021    end if
05022    PurchasesFilterNoItem: !
05023    let fnPurchasesFilter$="1"
05024 fnend
05025 !
05026 def fnInit_PurchasesFilter
05027    let PfInvFile=fnOpen("inventory",mat PfInv$,mat PfInv,mat Form$)
05028 fnend
05029 !
05030 def fnFinal_PurchasesFilter
05031    if PfInvFile then
05032       let fnCloseFile(PfInvFile,"inventory")
05033       let PfInvFile=0
05034    end if
05035 fnend
05036 !
05037 !
05038 !
85000    def library fnCheckStringFunction(Function$*255)
85001    if Function$ = "{purchasesfilter}" then
85002       let fnCheckStringFunction = 18
85003    else if Function$ = "{init_purchasesfilter}" then
85004       let fnCheckStringFunction = 0
85005    else if Function$ = "{final_purchasesfilter}" then
85006       let fnCheckStringFunction = 0
85007       else
85008          if Function$<>"{{GetData}}" and Function$<>"{{SetData}}" then
85009             print "Function ("&function$&") on screen PURCHASES is not Supported: The library is out of date or fn not found."
85010          end if
85011       end if
85012    fnend
