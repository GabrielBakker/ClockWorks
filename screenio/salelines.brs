01000 Main: ! If you run me as a program, I run the salelines screen
01010    library "screenio" : fnfm$
01020    let Ret$=fnfm$("salelines","",0,0,"",0,0,0,0,mat PassedData$)
01030    if len(trim$(Ret$)) then
01040       print Ret$
01050    end if
01060    if fkey=93 then execute "system"
01070    stop
01080 !
05000 CustomFunctions: ! Lines 5000 - 70000 are Custom Functions
05001 ! ============================================================
05002 ! Imported From "function\salelinesfilter.brs"
05003 ! function\salelinesfilter.brs
05004 ! Created on 10/09/2026
05005 !
05006 ! fnSaleLinesFilter$ - Filter for the SALELINES listview: shows only the lines of the
05007 !   sale in progress. REGISTER passes its invoice number in as ParentKey$ (through the
05008 !   SALELINES screen control's function text). Before the first item is rung up there
05009 !   is no invoice number yet, so nothing shows.
05010 !
05011 def fnSaleLinesFilter$
05012    if len(trim$(ParentKey$)) and trim$(f$(sl_invoiceno))=trim$(ParentKey$) then
05013       let fnSaleLinesFilter$="1"
05014    else
05015       let fnSaleLinesFilter$=""
05016    end if
05017 fnend
05018 !
05019 ! Imported From "function\removesaleline.brs"
05020 ! function\removesaleline.brs
05021 ! Created on 10/09/2026
05022 !
05023 ! fnRemoveSaleLine - Remove Line button on SALELINES. Asks first, then deletes the
05024 !   selected line from the sales file and refreshes the list. REGISTER's Main Loop
05025 !   recalculates the sale's totals when the clerk returns to it.
05026 !
05027 dim RlSales$(1)*1024, RlSales(1)
05028 !
05029 def fnRemoveSaleLine(;___,RlSalesFile)
05030    if trim$(CurrentKey$)="" or trim$(F$(SL_ITEMID))="" then
05031       let Msgbox("Please select the line to remove first.","Remove Line","OK","INF")
05032    else if 2==Msgbox("Remove "&trim$(F$(SL_DESCRIPTION))&" from this sale?","Remove Line","yN","QST") then
05033       let RlSalesFile=fnOpen("sales",mat RlSales$,mat RlSales,mat Form$)
05034       read #RlSalesFile, using form$(RlSalesFile), key=CurrentKey$: mat RlSales$, mat RlSales nokey RemoveLineGone
05035       delete #RlSalesFile:
05036       RemoveLineGone: !
05037       let fnCloseFile(RlSalesFile,"sales")
05038       let RepopulateListviews=1
05039    end if
05040 fnend
05041 !
