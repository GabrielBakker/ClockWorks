data\sales.dat, SL_, 2
data\sales.key, INVOICENO/LINENO
data\sales.ky2, ITEMID/SALEDATE
====================================================================================================
INVOICENO$,       Invoice Number,                           C 8,      ,                 1 -    8, 1 $
LINENO,           Line Number,                              BH 2,     ,                 9 -   10, 1
ITEMID$,          Item Number,                              C 8,      ,                11 -   18, 2 $
DESCRIPTION$,     Description as Sold,                      V 60,     ,                19 -   78, 3 $
QTY,              Quantity (hours for labor),               PD 5.2,   ,                79 -   83, 2

UNITPRICE,        Unit Price,                               PD 6.2,   ,                84 -   89, 3
DISCOUNT,         Line Discount,                            PD 6.2,   ,                90 -   95, 4
EXTENDED,         Extended Amount,                          PD 6.2,   ,                96 -  101, 5
TAXABLE$,         Taxable (Y/N),                            C 1,      ,               102 -  102, 4 $
SALEDATE,         Sale Date,                                BH 3,     DATE(Julian),   103 -  105, 6
