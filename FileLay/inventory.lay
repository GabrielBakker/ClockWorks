data\inventory.dat, IN_, 2
data\inventory.key, ITEMID
data\inventory.ky2, DESCRIPTION-U
data\inventory.ky3, CATEGORY-U/ITEMID
data\inventory.ky4, UPC
====================================================================================================
ITEMID$,          Item Number,                              C 8,      ,                 1 -    8, 1 $
UPC$,             UPC or Barcode,                           C 14,     ,                 9 -   22, 2 $
ITEMTYPE$,        Type: C=Clock P=Part S=Service,           C 1,      ,                23 -   23, 3 $
DESCRIPTION$,     Description,                              V 60,     ,                24 -   83, 4 $
CATEGORY$,        Category (Mantel Wall Tall Case etc),     C 12,     ,                84 -   95, 5 $

MAKER$,           Maker,                                    V 30,     ,                96 -  125, 6 $
ORIGIN$,          Country of Origin,                        V 20,     ,               126 -  145, 7 $
ERA$,             Era or Year Made,                         V 12,     ,               146 -  157, 8 $
CONDITION$,       Condition,                                C 10,     ,               158 -  167, 9 $
SERIALNO$,        Serial Number,                            V 20,     ,               168 -  187, 10 $

LOCATION$,        Display Location,                         V 20,     ,               188 -  207, 11 $
COST,             Unit Cost,                                PD 6.2,   ,               208 -  213, 1
PRICE,            Retail Price,                             PD 6.2,   ,               214 -  219, 2
QTYONHAND,        Quantity on Hand,                         PD 4,     ,               220 -  223, 3
TAXABLE$,         Taxable (Y/N),                            C 1,      ,               224 -  224, 12 $

STATUS$,          Status: A=Active H=Hold I=Inactive,       C 1,      ,               225 -  225, 13 $
DATEADDED,        Date Added,                               BH 3,     DATE(Julian),   226 -  228, 4
LASTSOLD,         Date Last Sold,                           BH 3,     DATE(Julian),   229 -  231, 5
NOTES$,           Notes and Provenance,                     V 255,    ,               232 -  486, 14 $
